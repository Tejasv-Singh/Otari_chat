# Copy to .env with `python scripts/init_env.py` (generates every secret below
# for you and never prints them). Never commit .env.

# Otari management credential (per otari docs/self-hosted-quickstart.md step 2).
OTARI_MASTER_KEY=
# Required by Otari's compose when provider copies of attached files are on
# (per otari docker-compose.yml, OTARI_PROVIDER_ACCOUNT_PEPPER). 32+ random chars.
OTARI_PROVIDER_ACCOUNT_PEPPER=

# One virtual key per agent cohort. Format: "tk-" + 47+ url-safe chars
# (per otari docs/configuration.md "The secret").
R2R_KEY_VILLAGER=
R2R_KEY_OFFICIAL=
R2R_KEY_AMPLIFIER=
R2R_KEY_DDO=

# Free, no-card fallback provider. Get a key at https://console.groq.com/keys
# Leave empty to run local-only (failover tests are then skipped).
GROQ_API_KEY=

# Host folder holding already-pulled Ollama models, mounted into the ollama
# container so nothing is downloaded twice. Default: ~/.ollama/models
OLLAMA_MODELS_DIR=
